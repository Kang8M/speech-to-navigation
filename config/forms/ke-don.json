    { "id": "tong_so_luong", "label": "Tổng số lượng", "type": "number", "required": false, "hint": "Lấy số lượng kê nếu bác sĩ nói, không thì tự tính với thuốc đếm được (viên, gói, ống)", "ai_fill": false },
    { "id": "ghi_chu", "label": "Ghi chú", "type": "text", "required": false, "hint": "", "ai_fill": true }
