    { "id": "so_lan_ngay", "label": "Số lần/ngày", "type": "number", "required": false, "hint": "Thuốc dùng khi cần: số lần tối đa mỗi ngày, bác sĩ không nói thì để trống", "ai_fill": true },
    { "id": "thoi_diem", "label": "Thời điểm dùng", "type": "text", "required": false, "hint": "Ví dụ: Sau ăn sáng, tối", "ai_fill": true },
