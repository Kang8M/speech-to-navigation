# Nhà cung cấp LLM: mock (mặc định, không cần internet) | anthropic | openai
LLM_PROVIDER=mock

# Dùng khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Dùng khi LLM_PROVIDER=openai (bắt buộc điền tên model)
OPENAI_API_KEY=
OPENAI_MODEL=

# Dịch vụ Zipformer STT local (chạy scripts/start-stt.ps1)
STT_BACKEND_URL=http://127.0.0.1:8765
