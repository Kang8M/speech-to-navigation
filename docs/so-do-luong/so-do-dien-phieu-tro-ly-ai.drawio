<mxfile host="app.diagrams.net"><diagram id="dien-phieu" name="Điền phiếu với Trợ lý AI"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1370" pageHeight="1200" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="" style="rounded=0;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="1350" height="1180" as="geometry"/></mxCell><mxCell id="v2" value="Trợ lý AI giúp bác sĩ điền phiếu khám nhanh hơn, học theo thói quen từng người" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="24" y="18" width="1150" height="34" as="geometry"/></mxCell><mxCell id="v3" value="Bác sĩ" style="swimlane;horizontal=1;startSize=34;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;fontFamily=Helvetica;collapsible=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="280" height="1110" as="geometry"/></mxCell><mxCell id="v4" value="✨ Trợ lý AI" style="swimlane;horizontal=1;startSize=34;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;fontFamily=Helvetica;collapsible=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="300" height="1110" as="geometry"/></mxCell><mxCell id="v5" value="Thói quen riêng của bác sĩ" style="swimlane;horizontal=1;startSize=34;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;fontFamily=Helvetica;collapsible=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="250" height="1110" as="geometry"/></mxCell><mxCell id="v6" value="Số đo" style="swimlane;horizontal=1;startSize=34;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;fontFamily=Helvetica;collapsible=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="60" width="240" height="1110" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Bắt đầu&lt;/b&gt;&lt;br&gt;Mở phiếu khám ngoại trú của bệnh nhân" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50.0" y="105" width="220" height="64" as="geometry"/></mxCell><mxCell id="v8" value="✨ &lt;b&gt;Nạp sẵn&lt;/b&gt; trước khi dùng: mã gõ tắt riêng (macro UniKey), câu quen của bác sĩ. &lt;i&gt;Sắp làm: lịch sử giả 2–4 tuần để buổi thử có sẵn thói quen&lt;/i&gt;" style="rounded=1;arcSize=8;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="610.0" y="100" width="230" height="100" as="geometry"/></mxCell><mxCell id="v9" value="⏱ &lt;b&gt;Hiện tại&lt;/b&gt;: khám ~5 phút, sửa phiếu ~11 phút (04/11); 3/6 ca hoàn thiện phiếu sau khi bệnh nhân đã ra (09/11)" style="rounded=1;arcSize=8;fillColor=#fdeeee;strokeColor=#b85450;dashed=1;fontColor=#333333;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860.0" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="v10" value="Điều dưỡng đã&lt;br&gt;điền sẵn?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60.0" y="210" width="200" height="90" as="geometry"/></mxCell><mxCell id="v11" value="Đặt con trỏ vào một ô: lý do khám, bệnh sử, khám chuyên khoa, chẩn đoán, hướng điều trị, lời dặn" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="345" width="240" height="75" as="geometry"/></mxCell><mxCell id="v12" value="✨ &lt;b&gt;Bong bóng&lt;/b&gt; (F2): nói hoặc gõ một câu cho cả ca, vd. tên phiếu mẫu → điền các ô còn trống, ô cần xem lại tô vàng" style="rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320.0" y="340" width="260" height="85" as="geometry"/></mxCell><mxCell id="v13" value="Gõ vài chữ hoặc mã gõ tắt (gõ tiếp thì chữ mờ tự biến mất)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="467" width="240" height="60" as="geometry"/></mxCell><mxCell id="v14" value="✨ Tìm câu quen của &lt;b&gt;chính bác sĩ này&lt;/b&gt; hợp ngữ cảnh: đúng ô, đúng chẩn đoán, lý do khám" style="rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320.0" y="460" width="260" height="75" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Bộ thói quen riêng&lt;/b&gt;&lt;br&gt;mã gõ tắt, câu quen, phiếu mẫu hay dùng, lời dặn và đơn đã kê&lt;br&gt;&lt;i&gt;sắp làm: câu đã gõ ở mọi ô&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="615.0" y="445" width="220" height="110" as="geometry"/></mxCell><mxCell id="v16" value="✨ Hiện &lt;b&gt;chữ mờ&lt;/b&gt; sau con trỏ" style="rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320.0" y="580" width="260" height="50" as="geometry"/></mxCell><mxCell id="v17" value="Đúng ý?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="75.0" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="v18" value="Bấm &lt;b&gt;Tab&lt;/b&gt;: nhận cả câu bằng một phím" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="690" width="240" height="55" as="geometry"/></mxCell><mxCell id="v19" value="Còn ô cần&lt;br&gt;điền, sửa?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="65.0" y="790" width="190" height="90" as="geometry"/></mxCell><mxCell id="v20" value="Bấm &lt;b&gt;Lưu&lt;/b&gt;" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40.0" y="925" width="240" height="50" as="geometry"/></mxCell><mxCell id="v21" value="✨ &lt;b&gt;Học thói quen&lt;/b&gt;: ghi câu bác sĩ đã dùng ở từng ô kèm chẩn đoán; câu được nhận tăng điểm, câu bị bỏ qua giảm điểm.&lt;br&gt;&lt;i&gt;Hiện mới học lời dặn và đơn; sắp làm: mọi ô và điểm nhận, bỏ&lt;/i&gt;" style="rounded=1;arcSize=8;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="320.0" y="900" width="260" height="110" as="geometry"/></mxCell><mxCell id="v22" value="Phiếu xong → sang chỉ định, kê đơn (ngoài sơ đồ này)" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="45.0" y="1030" width="230" height="64" as="geometry"/></mxCell><mxCell id="v23" value="⏱ &lt;b&gt;Khi Lưu, đếm&lt;/b&gt;: thời gian điền phiếu, số phím gõ, số lần bấm chuột, tỷ lệ nhận Tab.&lt;br&gt;&lt;b&gt;So&lt;/b&gt;: ca 1 → ca 5 cùng bệnh (AI học được không) và có / không có Trợ lý" style="rounded=1;arcSize=8;fillColor=#fdeeee;strokeColor=#b85450;dashed=1;fontColor=#333333;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="860.0" y="900" width="220" height="130" as="geometry"/></mxCell><mxCell id="v42" value="&lt;b&gt;Lưu ý:&lt;/b&gt; sơ đồ chỉ vẽ phần điền phiếu khám. AI chỉ học &lt;i&gt;cách viết&lt;/i&gt; của bác sĩ, không học quyết định chuyên môn; câu nào cũng phải được bác sĩ nhận. Gợi ý chữ mờ và phần học chạy trên máy, không cần LLM. Giọng nói chỉ là một cách nhập vào bong bóng." style="shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="60" width="210" height="165" as="geometry"/></mxCell><mxCell id="v43" value="Chú giải" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="255" width="210" height="20" as="geometry"/></mxCell><mxCell id="v44" value="Bác sĩ thao tác" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="285" width="190" height="36" as="geometry"/></mxCell><mxCell id="v45" value="✨ Trợ lý AI, đã có trong prototype" style="rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="335" width="190" height="40" as="geometry"/></mxCell><mxCell id="v46" value="✨ Phần sẽ làm thêm" style="rounded=1;arcSize=8;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=2;dashed=1;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="389" width="190" height="36" as="geometry"/></mxCell><mxCell id="v47" value="Dữ liệu thói quen, theo từng bác sĩ" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="439" width="190" height="50" as="geometry"/></mxCell><mxCell id="v48" value="Điều kiện rẽ nhánh" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="503" width="190" height="56" as="geometry"/></mxCell><mxCell id="v49" value="⏱ Số đo" style="rounded=1;arcSize=8;fillColor=#fdeeee;strokeColor=#b85450;dashed=1;fontColor=#333333;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="573" width="190" height="36" as="geometry"/></mxCell><mxCell id="v50" value="Chú thích" style="shape=note;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;whiteSpace=wrap;html=1;fontSize=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="623" width="190" height="34" as="geometry"/></mxCell><mxCell id="v51" value="Bắt đầu, kết thúc" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="671" width="190" height="44" as="geometry"/></mxCell><mxCell id="v52" value="Bước" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1130" y="739" width="60" height="30" as="geometry"/></mxCell><mxCell id="v53" value="✨" style="rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="739" width="60" height="30" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="Có: đọc lại, sửa chỗ chưa đúng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v10" target="v11"><mxGeometry x="-0.1" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v10" target="v11"><mxGeometry x="-0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="255"/><mxPoint x="35" y="382"/></Array></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v12" target="v11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v13" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="nạp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v15" target="v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v16" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v17" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v17" target="v13"><mxGeometry x="-0.75" relative="1" as="geometry"><Array as="points"><mxPoint x="35" y="605"/><mxPoint x="35" y="497"/></Array></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v18" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v19" target="v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="835"/><mxPoint x="290" y="401"/></Array></mxGeometry></mxCell><mxCell id="e38" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v19" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v20" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="cập nhật: lần sau gợi ý trúng hơn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v21" target="v15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="955"/></Array></mxGeometry></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v20" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="AI giúp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#d79b00;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v53" target="v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>