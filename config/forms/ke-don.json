    { "id": "duong_dung", "label": "Đường dùng", "type": "select", "options": ["Uống", "Ngậm", "Xịt mũi", "Nhỏ mũi", "Rửa mũi", "Nhỏ tai", "Súc họng", "Khí dung", "Bôi"], "required": false, "hint": "", "ai_fill": true },
